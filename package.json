{
  "name": "hosts-so-easy",
  "version": "1.2.9",
  "description": "Edit /etc/hosts safely, preserving its formatting",
  "main": "./src/index.cjs",
  "types": "./src/index.d.cts",
  "repository": {
    "type": "git",
    "url": "https://github.com/gadicc/node-hosts-so-easy"
  },
  "keywords": [
    "/etc/hosts",
    "hosts",
    "hostfile",
    "hostsfile"
  ],
  "author": "Gadi Cohen <dragon@wastelands.net>",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "coverage": "c8 --check-coverage --lines 95 --functions 95 --branches 90 --reporter=text --reporter=lcov --reporter=html node --test tests/*.test.js",
    "lint": "eslint .",
    "test:package": "node scripts/test-package.js",
    "prepublishOnly": "npm run lint && npm run coverage && npm run test:types && npm run test:release && npm run test:package",
    "semantic-release": "semantic-release",
    "test:release": "node --test scripts/release.test.js",
    "test:types": "tsc -p tests/types"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "c8": "12.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "all": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
