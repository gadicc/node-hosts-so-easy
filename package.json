{
  "name": "hosts-so-easy",
  "version": "1.2.9",
  "description": "Safe, parallel API for manipulating /etc/hosts",
  "main": "./src/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/gadicc/node-hosts-so-easy"
  },
  "keywords": [
    "/etc/hosts",
    "hosts",
    "hostfile",
    "hostsfile"
  ],
  "author": "Gadi Cohen <dragon@wastelands.net>",
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "write-file-atomic": "^8.0.0"
  },
  "scripts": {
    "test": "node --test src/*.test.js scripts/*.test.js",
    "coverage": "c8 --check-coverage --lines 95 --functions 95 --branches 90 --reporter=text --reporter=lcov --reporter=html node --test src/*.test.js scripts/*.test.js",
    "lint": "eslint .",
    "test:package": "node scripts/test-package.js",
    "prepublishOnly": "npm run lint && npm run coverage && npm run test:package",
    "semantic-release": "semantic-release",
    "test:release": "node --test scripts/release.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "semantic-release": "25.0.9",
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/index.cjs",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "all": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
